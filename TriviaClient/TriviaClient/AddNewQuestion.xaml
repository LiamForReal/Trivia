<Window x:Class="TriviaClient.AddNewQuestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TriviaClient"
        mc:Ignorable="d"
        Title="[Trivia] Add New Question" Height="600" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/add_new_question_background.png"/>
    </Window.Background>

    <GroupBox BorderThickness="2" BorderBrush="White" Margin="10" Foreground="Black">
        <GroupBox.Header>
            <Span FontWeight="Bold" Foreground="White" FontSize="18">
                Game
            </Span>
        </GroupBox.Header>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <Label Content="Add New Question" Foreground="Aqua" HorizontalAlignment="Center" FontSize="32" FontWeight="ExtraBold" Margin="10,-5,10,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <Label Name="QuestionLabel" Content="Question" Foreground="White" HorizontalAlignment="Center" FontSize="26" FontWeight="ExtraBold" Margin="10,25,10,0" />
                <TextBox x:Name="QuestionTextBox" Width="300" Height="20" Margin="5,0,5,0" />

                <StackPanel Orientation="Horizontal" Margin="5"  HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label Content="Correct Answer" Foreground="White" FontWeight="ExtraBold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                        <TextBox x:Name="CorrectAnswerTextBox" Width="300" Height="20" Margin="5,0,5,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label Content="First Wrong Answer" Foreground="White" FontWeight="ExtraBold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                        <TextBox x:Name="WrongAnswer1TextBox" Width="300" Height="20" Margin="5,0,5,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="5"  HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label Content="Second Wrong Answer" Foreground="White" FontWeight="ExtraBold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                        <TextBox x:Name="WrongAnswer2TextBox" Width="300" Height="20" Margin="5,0,5,0" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label Content="Third Wrong Answer" Foreground="White" FontWeight="ExtraBold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                        <TextBox x:Name="WrongAnswer3TextBox" Width="300" Height="20" Margin="5,0,5,0" />
                    </StackPanel>
                </StackPanel>


                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="Cancel" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="35,35" Click="CancelButton_Click"
                        Height="40"
                        Background="Red"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="18"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                    />
                    <Button x:Name="SubmitButton" Content="Submit" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="35,5" Click="SubmitButton_Click"
                        Height="40"
                        Background="Blue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="18"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                    />
                </StackPanel>

            </StackPanel>


        </Grid>
    </GroupBox>
</Window>
