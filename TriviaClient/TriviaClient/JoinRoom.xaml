<Window x:Class="TriviaClient.JoinRoom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TriviaClient"
        mc:Ignorable="d"
        Title="[Trivia] Join Room" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/join_room_background.png"/>
    </Window.Background>

    <GroupBox BorderThickness="2" BorderBrush="White" Margin="10" Foreground="Black">
        <GroupBox.Header>
            <Span FontWeight="Bold" Foreground="White" FontSize="18">
                Join Room
            </Span>
        </GroupBox.Header>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,0,5,5" Orientation="Vertical">
                <Label Content="Join Room" Foreground="Aqua" HorizontalAlignment="Center" FontSize="32" FontWeight="ExtraBold" Margin="10,-5,10,0" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,70,5,5" Orientation="Vertical">
                <Rectangle Grid.RowSpan="4"
                Grid.ColumnSpan="2"
                Width="580"
                Height="300"
                Panel.ZIndex="-1"
                Fill="Orange"
                Opacity=".5"
                RadiusX="8"
                RadiusY="8"
                Stroke="OrangeRed"
                StrokeThickness="2" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,10,5,5" Orientation="Vertical">
                <Label Content="Rooms List: " Foreground="White" FontWeight="ExtraBlack" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,75,5,10" FontSize="24"/>
                <ListBox Name="RoomsListBox" Width="200" Height="200" SelectionChanged="RoomsListBox_SelectionChanged">
                    <!--ListBoxItem Content="Jubzik's Room"></ListBoxItem-->
                </ListBox>
                <Label Name="NoRoomsAvailable" Content="No Rooms Available" Foreground="White" FontWeight="ExtraBold" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="5" Orientation="Vertical">
                <Button Name="JoinButton" Content="Join" Width="100" Click="JoinButton_Click" Margin="5"
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="18"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="5" Orientation="Vertical">
                <Button Name="QuitButton" Content="Quit" Width="100" Click="QuitButton_Click" Margin="5"
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="18"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
            </StackPanel>


        </Grid>
    </GroupBox>
</Window>
