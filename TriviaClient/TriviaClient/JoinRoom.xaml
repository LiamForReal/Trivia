<Window x:Class="TriviaClient.JoinRoom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TriviaClient"
        mc:Ignorable="d"
        Title="[Trivia] Join Room" Height="600" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/join_room_background.png"/>
    </Window.Background>
    
    <GroupBox BorderThickness="3" BorderBrush="Black" Margin="10" Foreground="Black">
        <GroupBox.Header>
            <Span FontWeight="Bold" Foreground="White" FontSize="18">
                Join Room
            </Span>
        </GroupBox.Header>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,25,5,5" Orientation="Vertical">
                <Label Content="Join Room" Foreground="Aqua" HorizontalAlignment="Center" FontSize="22" FontWeight="ExtraBold" Margin="10,-5,10,0" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,70,5,5" Orientation="Vertical">
                <Rectangle Grid.RowSpan="4"
                Grid.ColumnSpan="2"
                Width="580"
                Height="240"
                Panel.ZIndex="-1"
                Fill="Orange"
                Opacity=".5"
                RadiusX="8"
                RadiusY="8"
                Stroke="OrangeRed"
                StrokeThickness="2" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,10,5,5" Orientation="Horizontal">
                <Label Content="Room Name: " Foreground="White" FontWeight="ExtraBlack" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100,5,5,5"/>
                <TextBox x:Name="RoomNameTextBox" Width="200" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="79"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,70,5,5" Orientation="Horizontal">
                <Label Content="Number Of Players: " Foreground="White" FontWeight="ExtraBlack" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100,5,5,5"/>
                <TextBox x:Name="NumberOfPlayersTextBox" Width="200" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,130,5,5" Orientation="Horizontal">
                <Label Content="Number Of Questions: " Foreground="White" FontWeight="ExtraBlack" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100,5,5,5"/>
                <TextBox x:Name="NumberOfQuestionsTextBox" Width="200" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,190,5,5" Orientation="Horizontal">
                <Label Content="Time For Question: " Foreground="White" FontWeight="ExtraBlack" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100,5,5,5"/>
                <TextBox x:Name="TimeForQuestionTextBox" Width="200" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="20" Orientation="Vertical">
                <Button Name="RefreshButton" Content="Refresh" Width="100" Height="20" Click="RefreshButton_Click" Margin="5"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="20" Orientation="Vertical">
                <Button Name="JoinButton" Content="Join" Width="100" Height="20" Click="JoinButton_Click" Margin="5"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="20" Orientation="Vertical">
                <Button Name="QuitButton" Content="Quit" Width="100" Height="20" Click="QuitButton_Click"/>
            </StackPanel>


        </Grid>
    </GroupBox>
</Window>
