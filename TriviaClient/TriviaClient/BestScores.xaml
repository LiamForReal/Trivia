<Window x:Class="TriviaClient.BestScores"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TriviaClient"
        mc:Ignorable="d"
        Title="[Trivia] Best Scores" Height="450" Width="500">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/best_scores_background.jpg"></ImageBrush>
    </Window.Background>

    <GroupBox BorderThickness="3" BorderBrush="Black" Margin="10" Foreground="Black">
        <GroupBox.Header>
            <Span FontWeight="Bold" Foreground="White" FontSize="18">
                Best Scores
            </Span>
        </GroupBox.Header>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,25,5,5" Orientation="Vertical">
                <Label Content="Best Scores" Foreground="Aqua"  HorizontalAlignment="Center" FontSize="22" FontWeight="ExtraBold" Margin="10,-5,10,0" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,70,5,5" Orientation="Vertical">
                <Rectangle Grid.RowSpan="4"
                   Grid.ColumnSpan="2"
                   Width="300"
                   Height="200"
                   Panel.ZIndex="-1"
                   Fill="Orange"
                   Opacity=".5"
                   RadiusX="8"
                   RadiusY="8"
                   Stroke="OrangeRed"
                   StrokeThickness="2" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,80,5,5" Orientation="Vertical">
                <Label Name="FirstPlaceLabel" Content="1. Gavriel - 0 Points" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" FontSize="16" Margin="5"/>
                <Label Name="SecondPlaceLabel" Content="2. Liam - 0 Points" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" FontSize="16" Margin="5"/>
                <Label Name="ThirdPlaceLabel" Content="3. Jubzik - 0 Points" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" FontSize="16" Margin="5"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="20" Orientation="Vertical">
                <Button Name="QuitButton" Content="Quit" Width="100" Height="20" Click="QuitButton_Click"/>
            </StackPanel>

        </Grid>
    </GroupBox>
</Window>
