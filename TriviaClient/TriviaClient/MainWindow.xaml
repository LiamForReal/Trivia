<Window x:Class="TriviaClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TriviaClient"
        mc:Ignorable="d"
        Title="Trivia" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Window.OpacityMask>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FF00EBD5" Offset="1"/>
        </LinearGradientBrush>
    </Window.OpacityMask>
    <Window.Background>
        <ImageBrush ImageSource="/Resources/background.jpg"/>
    </Window.Background>

    <GroupBox BorderThickness="1" BorderBrush="White" Margin="10" Foreground="White">
        <GroupBox.Header>
            <Span FontWeight="Bold" Foreground="White" FontSize="18">
                Trivia Menu
            </Span>
        </GroupBox.Header>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="89*" />
                <RowDefinition Height="281*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,5,5,5" Orientation="Vertical">
                <Label Content="Trivia" Foreground="Aqua"  HorizontalAlignment="Center" FontSize="40" FontWeight="ExtraBold" Margin="10,0,10,0" />
                <Label Name="HelloLabel" Content="" Foreground="Aqua" HorizontalAlignment="Center" FontSize="24" FontWeight="ExtraBold" Margin="5" />
                <Button Name="LogInButton" Content="Log In" Width="140" Margin="5" Click="LoginButton_Click"
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="20"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
                <Button Name="SignUpButton" Content="Sign Up" Width="140" Margin="5" Click="SignUpButton_Click"                        
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="20"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
                <Button Name="JoinRoomButton" Content="Join Room" Width="140" Margin="5" Click="JoinRoomButton_Click"
                        IsEnabled="False"
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="20"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
                <Button Name="CreateRoomButton" Content="Create Room" Width="140" Margin="5" Click="CreateRoomButton_Click"                        
                        Height="40"
                        IsEnabled="False"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="20"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
                <Button Name="StatsMenuButton" Content="Stats Menu" Width="140" Margin="5" Click="StatsMenuButton_Click"      
                        IsEnabled="False"
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="20"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
                <Button Name="LogOutButton" Content="Log Out" Width="140" Margin="5" Click="LogOutButton_Click"                         
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="20"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1">
                <Button Name="QuitButton" Content="Quit" Width="100" Click="QuitButton_Click"                        
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="20"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
            </StackPanel>
        </Grid>
    </GroupBox>
</Window>
