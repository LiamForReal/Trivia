<Window x:Class="TriviaClient.ConnectedRoom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TriviaClient"
        mc:Ignorable="d"
        Title="[Trivia] Connected Room" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/connected_room_background.jpg"/>
    </Window.Background>
    <GroupBox BorderThickness="3" BorderBrush="Black" Margin="10" Foreground="Black">
        <GroupBox.Header>
            <Span FontWeight="Bold" Foreground="White" FontSize="18">
                Connected Room
            </Span>
        </GroupBox.Header>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,0,5,5" Orientation="Vertical">
                <Label Name="ConnectedRoomNameLabel" Content="Room Name" Foreground="Aqua" HorizontalAlignment="Center" FontSize="32" FontWeight="ExtraBold" Margin="10,-5,10,0" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,70,5,5" Orientation="Vertical">
                <Rectangle Grid.RowSpan="4"
            Grid.ColumnSpan="2"
            Width="580"
            Height="300"
            Panel.ZIndex="-1"
            Fill="Orange"
            Opacity=".5"
            RadiusX="8"
            RadiusY="8"
            Stroke="OrangeRed"
            StrokeThickness="2" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,10,5,5" Orientation="Vertical">
                <Label Content="Players In Room: " Foreground="White" FontWeight="ExtraBlack" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,75,5,10" FontSize="24"/>
                <ListBox Name="PlayersListBox" Width="200" Height="200">
                </ListBox>
            </StackPanel>

            <!-- Buttons For User -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="5" Orientation="Vertical">
                <Button Name="LeaveRoomButton" Content="Leave Room" Width="100" Click="LeaveRoomButton_Click" Margin="5"
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="15"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
            </StackPanel>

            <!-- Buttons For Owner -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="5" Orientation="Vertical">
                <Button Name="StartGameButton" Content="Start Game" Width="100" Click="StartGameButton_Click" Margin="5" Visibility="Collapsed" IsEnabled="False"
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="15"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />

                <Button Name="CloseRoomButton" Content="Close Room" Width="100" Click="CloseRoomButton_Click" Margin="5" Visibility="Collapsed" IsEnabled="False"
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="15"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
            </StackPanel>

        </Grid>
    </GroupBox>
</Window>
