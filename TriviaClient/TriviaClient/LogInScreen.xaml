<Window x:Class="TriviaClient.LogInScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TriviaClient"
        mc:Ignorable="d"
        Title="[Trivia] Log In" Height="450" Width="400" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/login_background.jpg"/>
    </Window.Background>

    <GroupBox BorderThickness="3" BorderBrush="Black" Margin="10" Foreground="Black">
        <GroupBox.Header>
            <Span FontWeight="Bold" Foreground="White" FontSize="18">
                Log In
            </Span>
        </GroupBox.Header>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,5,5,5" Orientation="Vertical">
                <Label Content="Log In" Foreground="Aqua"  HorizontalAlignment="Center" FontSize="22" FontWeight="ExtraBold" Margin="10,-10,10,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="10, 40, 10, 10" Orientation="Horizontal" HorizontalAlignment="Left">
                <Label Content="Username: " Foreground="White" HorizontalAlignment="Left" FontSize="18" FontWeight="ExtraBold" Margin="0,0,2,0" />
                <TextBox x:Name="UsernameTextBox" Width="100" Height="20" Margin="5,0,5,0" TextWrapping="NoWrap"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="10, 0, 10, 20" Orientation="Horizontal" HorizontalAlignment="Left">
                <Label Content="Password: " Foreground="White" HorizontalAlignment="Left" FontSize="18" FontWeight="ExtraBold" Margin="0,0,5,0" />
                <PasswordBox x:Name="PasswordTextBox" Width="100" Height="20"  Margin="5,0,5,0" />
                <TextBox x:Name="RevealedTextBox" Width="100" Height="20" Visibility="Collapsed"  Grid.Row="2" Margin="5,0,5,0" HorizontalAlignment="Right"/>
                <Button Style="{DynamicResource RevealButtonStyle}" x:Name="RevealPasswordButton" Width="40" Height="20" Margin="5" Click="RevealPasswordButton_Click">
                    <Image x:Name="ShowPasswordImage" Source="/Resources/show_password.png" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" HorizontalAlignment="Center" Orientation="Horizontal" Margin="10, 10, 10, 10">
                <Button Name="CancelButton" Content="Cancel" Width="100" HorizontalAlignment="Left" Margin="20" Click="CancelButton_Click"
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="18"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
                <Button x:Name="LogInButton" Content="Log In" Width="100" HorizontalAlignment="Right" Margin="20" Click="LogInButton_Click"
                        Height="40"
                        Background="RoyalBlue"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="18"
                        FontWeight="DemiBold"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Opacity="0.8"
                />
            </StackPanel>

        </Grid>
    </GroupBox>
</Window>
