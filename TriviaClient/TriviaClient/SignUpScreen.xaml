<Window x:Class="TriviaClient.SignUpScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TriviaClient"
        mc:Ignorable="d"
        Title="[Trivia] Sign Up" Height="450" Width="400">
    <Window.Background>
        <ImageBrush ImageSource="../Resources/sign_up_background.jpg"/>
    </Window.Background>


    <GroupBox BorderThickness="3" BorderBrush="Black" Margin="10" Foreground="Black">
        <GroupBox.Header>
            <Span FontWeight="Bold" Foreground="White" FontSize="18">
                Trivia
            </Span>
        </GroupBox.Header>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,5,5,5" Orientation="Vertical">
                <Label Content="Sign Up" Foreground="Aqua"  HorizontalAlignment="Center" FontSize="22" FontWeight="ExtraBold" Margin="10,-10,10,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="10, 40, 10, 10" Orientation="Horizontal" HorizontalAlignment="Left">
                <Label Content="Username: " Foreground="White" HorizontalAlignment="Left" FontSize="18" FontWeight="ExtraBold" Margin="0,0,2,0" />
                <TextBox x:Name="UsernameTextBox" Width="100" Height="20" Margin="5,0,5,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="10, 0, 10, 20" Orientation="Horizontal" HorizontalAlignment="Left">
                <Label Content="Password: " Foreground="White" HorizontalAlignment="Left" FontSize="18" FontWeight="ExtraBold" Margin="0,0,5,0" />
                <PasswordBox x:Name="PasswordTextBox" Width="100" Height="20"  Margin="5,0,5,0" />
                <TextBox x:Name="RevealedTextBox" Width="100" Height="20" Visibility="Collapsed"  Grid.Row="2" Margin="5,0,5,0" HorizontalAlignment="Right"/>
                <Button x:Name="RevealPasswordButton" Width="40" Height="20" Margin="5" Click="RevealPasswordButton_Click">
                    <Image x:Name="ShowPasswordImage" Source="../Resources/show_password.png" />
                </Button>            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="10, 0, 10, 20" Orientation="Horizontal" HorizontalAlignment="Left">
                <Label Content="Email: " Foreground="White" HorizontalAlignment="Left" FontSize="18" FontWeight="ExtraBold" Margin="0,0,5,0" />
                <TextBox x:Name="EmailTextBox" Width="100" Height="20" Margin="42,0,5,5"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" HorizontalAlignment="Center" Orientation="Horizontal" Margin="10, 10, 10, 10">
                <Button Name="CancelButton" Content="Cancel" Height="20" Width="60" HorizontalAlignment="Left" Margin="20" Click="CancelButton_Click"/>
                <Button Name="SignUpButton" Content="Sign Up" Height="20" Width="60" HorizontalAlignment="Right" Margin="20" Click="SignUpButton_Click"/>
            </StackPanel>

        </Grid>
    </GroupBox>
</Window>
